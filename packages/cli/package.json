{
  "name": "kosmesis",
  "version": "0.3.0",
  "description": "CLI to add Kosmesis components — the shadcn/ui equivalent for PraxisJS — into your project",
  "type": "module",
  "bin": {
    "kosmesis": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsdown": "0.22.4",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "praxisjs",
    "kosmesis",
    "ui",
    "components",
    "cli"
  ],
  "packageManager": "pnpm@10.30.2",
  "license": "MIT"
}
